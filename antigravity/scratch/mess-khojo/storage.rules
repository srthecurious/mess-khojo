rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper: Checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Checks if the user is the system operator
    function isOperator() {
      return isAuthenticated() && request.auth.token.email == 'messkhojooperator@gmail.com';
    }

    // Helper: Checks if the user has admin role in Firestore
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper: Image file size and type validation
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // Max 5MB
          && request.resource.contentType.matches('image/.*');
    }

    // Public read access for all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Rules for mess posters, room images, and gallery images
    // Admins and Operators can upload to these directories
    match /posters/{allPaths=**} {
      allow write: if (isOperator() || isAdmin()) && isValidImage();
    }

    match /gallery/{allPaths=**} {
      allow write: if (isOperator() || isAdmin()) && isValidImage();
    }

    match /rooms/{allPaths=**} {
      allow write: if (isOperator() || isAdmin()) && isValidImage();
    }

    // Hero ads: Only the operator can upload
    match /hero_ads/{allPaths=**} {
      allow write: if isOperator() && isValidImage();
    }

    // Team member profile avatars
    match /team_avatars/{allPaths=**} {
      allow write: if (isOperator() || isAdmin() || isAuthenticated()) && isValidImage();
    }
  }
}
