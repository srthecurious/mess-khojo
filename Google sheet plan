## 4. Frontend Client Implementation

### File 1: `googleSheetSyncService.js`
Path: `client/src/services/googleSheetSyncService.js`

This service handles:
1. **`formatMessesForPush(messes, rooms)`**: Aggregates room pricing & vacancies per mess and shapes them into table rows.
2. **`pushToGoogleSheet(messes, rooms)`**: Sends payload via HTTP POST.
3. **`pullFromGoogleSheet()`**: Fetches sheet data via HTTP GET.
4. **`computeDiff(sheetData, messes, rooms)`**: Compares sheet values against Firestore values and flags only modified records.
5. **`commitDiffToFirestore(diffList)`**: Commits selected changes to Firestore using batch updates.

```javascript
import { doc, updateDoc, writeBatch } from 'firebase/firestore';
import { db } from '../firebase';

// Webhook URL configured from Google Apps Script deployment
const SHEET_WEBHOOK_URL = import.meta.env.VITE_GOOGLE_SHEET_WEBHOOK_URL || '';

export const SHEET_HEADERS = [
  'Mess ID', 'Mess Name', 'Contact Number', 'District', 'City', 'Locality',
  'Address', 'Gender / Type', 'Food Facility', 'Security Deposit', 'Rent Cycle',
  'Single Bed Rent', 'Double Bed Rent', 'Triple Bed Rent', 'Total Vacancies',
  'Status', 'Google Maps URL', 'Last Synced At'
];

/**
 * Transforms messes and rooms into Google Sheet row arrays
 */
export function formatMessesForPush(messes, rooms) {
  const nowStr = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });

  const rows = messes.map(mess => {
    // Collect rooms for this mess
    const messRooms = rooms.filter(r => r.messId === mess.id);

    const singleRoom = messRooms.find(r => (r.occupancy || r.roomType || '').toLowerCase().includes('single'));
    const doubleRoom = messRooms.find(r => (r.occupancy || r.roomType || '').toLowerCase().includes('double'));
    const tripleRoom = messRooms.find(r => (r.occupancy || r.roomType || '').toLowerCase().includes('triple'));

    const totalVacancies = messRooms.reduce((acc, r) => acc + (Number(r.availableCount) || 0), 0);

    const mapsUrl = mess.locationUrl || 
      (mess.location ? `https://www.google.com/maps?q=${mess.location.latitude},${mess.location.longitude}` : '');

    return [
      mess.id || '',
      mess.name || mess.messName || '',
      mess.contact || mess.phoneNumber || '',
      mess.district || '',
      mess.city || '',
      mess.locality || '',
      mess.address || '',
      Array.isArray(mess.messType) ? mess.messType.join(', ') : (mess.messType || 'Boys'),
      mess.foodAvailability || mess.foodFacility || '',
      mess.securityDeposit || '',
      mess.rentCycle || 'monthly',
      singleRoom ? (singleRoom.price || singleRoom.rent || 0) : '',
      doubleRoom ? (doubleRoom.price || doubleRoom.rent || 0) : '',
      tripleRoom ? (tripleRoom.price || tripleRoom.rent || 0) : '',
      totalVacancies,
      mess.hidden ? 'Hidden' : 'Live',
      mapsUrl,
      nowStr
    ];
  });

  return { headers: SHEET_HEADERS, rows };
}

/**
 * PUSH: Sends website data to Google Sheet
 */
export async function pushToGoogleSheet(messes, rooms) {
  if (!SHEET_WEBHOOK_URL) {
    throw new Error('Google Sheet Webhook URL is not configured. Set VITE_GOOGLE_SHEET_WEBHOOK_URL in .env');
  }

  const payload = formatMessesForPush(messes, rooms);

  const response = await fetch(SHEET_WEBHOOK_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(payload)
  });

  const resJson = await response.json();
  if (resJson.status !== 'success') {
    throw new Error(resJson.message || 'Failed to update Google Sheet');
  }

  return resJson; // { updated, inserted, totalProcessed }
}

/**
 * PULL: Fetches rows from Google Sheet
 */
export async function pullFromGoogleSheet() {
  if (!SHEET_WEBHOOK_URL) {
    throw new Error('Google Sheet Webhook URL is not configured.');
  }

  const response = await fetch(SHEET_WEBHOOK_URL);
  const resJson = await response.json();

  if (resJson.status !== 'success') {
    throw new Error(resJson.message || 'Failed to fetch from Google Sheet');
  }

  return resJson.data; // Array of row objects keyed by header
}

/**
 * Computes difference between sheet data and current Firestore data
 */
export function computeDiff(sheetRows, currentMesses) {
  const messMap = new Map(currentMesses.map(m => [m.id, m]));
  const diffs = [];

  sheetRows.forEach(row => {
    const messId = (row['Mess ID'] || '').trim();
    if (!messId || !messMap.has(messId)) return;

    const current = messMap.get(messId);
    const changes = {};

    // 1. Name
    const sheetName = (row['Mess Name'] || '').trim();
    if (sheetName && sheetName !== (current.name || current.messName || '')) {
      changes.name = { old: current.name || current.messName || '', new: sheetName };
    }

    // 2. Contact Number
    const sheetContact = String(row['Contact Number'] || '').trim();
    if (sheetContact && sheetContact !== String(current.contact || current.phoneNumber || '')) {
      changes.contact = { old: current.contact || '', new: sheetContact };
    }

    // 3. Locality
    const sheetLocality = (row['Locality'] || '').trim();
    if (sheetLocality && sheetLocality !== (current.locality || '')) {
      changes.locality = { old: current.locality || '', new: sheetLocality };
    }

    // 4. Food Facility
    const sheetFood = (row['Food Facility'] || '').trim();
    if (sheetFood && sheetFood !== (current.foodAvailability || current.foodFacility || '')) {
      changes.foodAvailability = { old: current.foodAvailability || '', new: sheetFood };
    }

    // 5. Visibility (Status)
    const sheetStatus = (row['Status'] || '').trim().toLowerCase();
    const currentStatus = current.hidden ? 'hidden' : 'live';
    if (sheetStatus && (sheetStatus === 'live' || sheetStatus === 'hidden') && sheetStatus !== currentStatus) {
      changes.hidden = { old: current.hidden || false, new: sheetStatus === 'hidden' };
    }

    if (Object.keys(changes).length > 0) {
      diffs.push({
        messId,
        messName: current.name || current.messName || 'Unknown Mess',
        changes
      });
    }
  });

  return diffs;
}

/**
 * Commits approved diffs into Firestore
 */
export async function applyDiffToFirestore(diffs) {
  const batch = writeBatch(db);

  diffs.forEach(diff => {
    const ref = doc(db, 'messes', diff.messId);
    const updatePayload = {};

    Object.entries(diff.changes).forEach(([field, change]) => {
      updatePayload[field] = change.new;
    });

    batch.update(ref, updatePayload);
  });

  await batch.commit();
}
```

