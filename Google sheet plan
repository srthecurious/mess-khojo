## 3. Google Apps Script Implementation (`Code.gs`)

### Step-by-Step Setup in Google Sheets:
1. Create a Google Sheet named **`MessKhojo - Master Mess Directory`**.
2. Rename the active sheet tab to **`Messes`**.
3. Open **Extensions** ➔ **Apps Script**.
4. Replace the default code with the following snippet:

```javascript
/**
 * MessKhojo Two-Way Google Sheet Sync Script
 */
const SHEET_NAME = "Messes";
const ID_COL_INDEX = 1; // Column A (Mess ID)

/**
 * 1. PUSH HANDLER (Website -> Google Sheet)
 * Performs smart upsert: Updates existing rows, appends new rows.
 */
function doPost(e) {
  try {
    const lock = LockService.getScriptLock();
    lock.waitLock(15000); // Wait up to 15s to prevent concurrent write collisions

    const payload = JSON.parse(e.postData.contents);
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
    
    if (!sheet) {
      throw new Error(`Sheet with name "${SHEET_NAME}" not found.`);
    }

    // Ensure Headers exist if sheet is blank
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(payload.headers);
    }

    const lastRow = sheet.getLastRow();
    const existingIds = {};

    // Map existing Mess IDs to row numbers (1-indexed)
    if (lastRow > 1) {
      const idValues = sheet.getRange(2, ID_COL_INDEX, lastRow - 1, 1).getValues();
      idValues.forEach((row, idx) => {
        if (row[0]) {
          existingIds[String(row[0]).trim()] = idx + 2; // +2 accounts for 0-index and header row
        }
      });
    }

    let updatedCount = 0;
    let insertedCount = 0;

    payload.rows.forEach(rowValues => {
      const messId = String(rowValues[0]).trim();
      if (!messId) return;

      if (existingIds[messId]) {
        // UPDATE existing row: writes exactly the length of rowValues (leaving columns S+ untouched)
        const targetRow = existingIds[messId];
        sheet.getRange(targetRow, 1, 1, rowValues.length).setValues([rowValues]);
        updatedCount++;
      } else {
        // INSERT new mess at bottom
        sheet.appendRow(rowValues);
        insertedCount++;
      }
    });

    lock.releaseLock();

    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      updated: updatedCount,
      inserted: insertedCount,
      totalProcessed: payload.rows.length,
      timestamp: new Date().toISOString()
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: err.message
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

/**
 * 2. PULL HANDLER (Google Sheet -> Website)
 * Returns all spreadsheet rows as a structured JSON array.
 */
function doGet(e) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);
    const data = sheet.getDataRange().getValues();

    if (data.length <= 1) {
      return ContentService.createTextOutput(JSON.stringify({
        status: "success",
        data: []
      })).setMimeType(ContentService.MimeType.JSON);
    }

    const headers = data[0];
    const rows = data.slice(1);

    const result = rows.map(row => {
      const item = {};
      headers.forEach((header, index) => {
        if (header) {
          item[header.trim()] = row[index];
        }
      });
      return item;
    });

    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      data: result
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: err.message
    })).setMimeType(ContentService.MimeType.JSON);
  }
}
```

